<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 大模型 API 调用（http 包）需要网络权限；缺了这一条，
         图片转课表与一句话改课表都无法联网。 -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 在线更新：允许 App 调起系统安装器安装自己下载的 APK。
         Android 8.0+ 必须声明这条权限（用户仍需在系统里允许「安装未知应用」）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- 上课提醒：Android 13+ 发送通知需要运行时权限。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 上课提醒：Android 12+ 精确闹钟；未授权时原生代码自动降级为不精确闹钟。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- 上课提醒：重启后恢复已排的闹钟。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- 允许明文 HTTP：用户可能把 OpenAI 兼容端点配置成局域网 http 地址
         （Ollama / one-api / vLLM 等）。 -->
    <application
        android:label="课序"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 在线更新：把缓存目录里下载好的 APK 以 content:// URI 交给系统安装器。
             authorities 必须与 MainActivity 里 FileProvider.getUriForFile 的
             "$packageName.fileprovider" 一致。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 桌面小组件「今日课表」：系统通过 APPWIDGET_UPDATE 广播驱动更新。 -->
        <receiver
            android:name=".TimetableWidgetProvider"
            android:exported="false"
            android:label="今日课表">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timetable_widget_info" />
        </receiver>

        <!-- 上课提醒：闹钟到点后发通知。只接收本 App 的 PendingIntent。 -->
        <receiver
            android:name=".NotificationReceiver"
            android:exported="false" />

        <!-- 开机 / App 更新 / 时区或时间变化后恢复提醒排程。 -->
        <receiver
            android:name=".ClassReminderBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
